{
  "version": 2,
  "buildCommand": "cd backend && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.py"
    }
  ],
  "env": {
    "DEBUG": "@debug",
    "DATABASE_URL": "@database_url",
    "SECRET_KEY": "@secret_key"
  }
}

